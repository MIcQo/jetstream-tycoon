# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go is formatted by gofmt (tabs).
[*.go]
indent_style = tab
indent_size = 4

# Make requires tabs for recipes.
[Makefile]
indent_style = tab

[*.{sql,xml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Generated native projects keep their tools' own formatting.
[mobile/{ios,android}/**]
indent_size = unset
indent_style = unset
