{
  "name": "jetstream-tycoon-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-wasm-exec.mjs && vite",
    "build": "node scripts/copy-wasm-exec.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "audit": "npm audit --audit-level=high",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:mutate": "node scripts/mutate.mjs"
  },
  "devDependencies": {
    "@eslint/js": ">=9.17.0",
    "eslint": ">=9.17.0",
    "fast-check": ">=3.23.2",
    "typescript": ">=5.7.2",
    "typescript-eslint": ">=8.18.1",
    "vitest": ">=5.1.1",
    "@preact/preset-vite": "2.10.6",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@sentry/browser": "10.76.2",
    "@sentry/capacitor": "4.5.0",
    "i18next": "27.0.1",
    "i18next-icu": "2.7.0",
    "intl-messageformat": "12.1.5",
    "preact": "11.2.0"
  }
}
